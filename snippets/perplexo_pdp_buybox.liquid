{% comment %}
  Renders the Perplexo luxury PDP buy box.
  Accepts:
  - product: {Object} Shopify product object
  - section: {Object} Section object
{% endcomment %}

{{ 'perplexo-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_price = current_variant.compare_at_price
  assign price = current_variant.price
  assign has_discount = false
  assign savings_amount = 0
  
  if compare_price > price
    assign has_discount = true
    assign savings_amount = compare_price | minus: price
  endif

  assign is_diy_product = false
  assign diy_title = product.title | downcase
  assign diy_handle = product.handle | downcase
  if diy_title contains 'diy' or diy_handle contains 'diy'
    assign is_diy_product = true
  endif
  for diy_tag in product.tags
    assign diy_tag_down = diy_tag | downcase
    if diy_tag_down == 'diy' or diy_tag_down contains 'diy'
      assign is_diy_product = true
      break
    endif
  endfor
-%}

{%- if is_diy_product -%}
  {{ 'perplexo-diy-offers.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<div class="perplexo-pdp-buybox{% if is_diy_product %} perplexo-pdp-buybox--diy{% endif %}" id="PerplexoBuyBox-{{ section.id }}">
  
  <!-- Vendor & Title -->
  {%- if product.vendor != blank -%}
    <span class="perplexo-card__vendor">{{ product.vendor | escape }}</span>
  {%- endif -%}

  <h1 class="perplexo-pdp__title">{{ product.title | escape }}</h1>

  <!-- Social Proof Star Rating -->
  <div class="perplexo-pdp__rating-badge">
    <span class="perplexo-pdp__stars">★★★★★</span>
    <span><strong>4.9/5</strong> (1,280+ Verified Reviews)</span>
  </div>

  <!-- Price & Savings Display -->
  <div class="perplexo-pdp__price-wrap">
    <span class="perplexo-pdp__price-main">{{ price | money }}</span>
    {%- if has_discount -%}
      <span class="perplexo-pdp__price-compare">{{ compare_price | money }}</span>
      <span class="perplexo-pdp__save-badge">SAVE {{ savings_amount | money }}</span>
    {%- endif -%}
  </div>

  <!-- Urgency Stock Pill -->
  <div class="perplexo-pdp__urgency-pill">
    <span class="perplexo-pdp__urgency-pulse"></span>
    <span><strong>⚡ In High Demand:</strong> Free shipping · Delivery in 3–5 business days</span>
  </div>

  <!-- Buy Box Checkout Form -->
  <form method="post" action="/cart/add" class="perplexo-pdp__form" id="PerplexoPdpForm-{{ section.id }}">
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    <input type="hidden" name="quantity" value="1">

    {%- if is_diy_product -%}
      {% render 'perplexo_diy_offers', product: product, section: section, part: 'tiers' %}
    {%- else -%}
      <div class="perplexo-pdp__qb-slot" id="PerplexoQbSlot-{{ section.id }}"></div>

      <div class="perplexo-pdp__actions">
        <button
          type="submit"
          name="add"
          onclick="this.form.action='/cart/add?return_to=/checkout';"
          class="perplexo-pdp__btn-buy-now"
          {% if current_variant.available == false %}disabled{% endif %}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 2L3 14h7v8l10-12h-7z"/>
          </svg>
          <span>{% if current_variant.available %}Buy Now — Instant Checkout{% else %}Sold Out{% endif %}</span>
        </button>

        <button
          type="submit"
          name="add"
          class="perplexo-pdp__btn-add-cart"
          {% if current_variant.available == false %}disabled{% endif %}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span>Add to Cart</span>
        </button>
      </div>
    {%- endif -%}
  </form>

  {%- if is_diy_product -%}
    {% render 'perplexo_diy_offers', product: product, section: section, part: 'fbt' %}
  {%- endif -%}

  <!-- 4 Trust Badges Grid -->
  <div class="perplexo-pdp__trust-grid">
    <div class="perplexo-pdp__trust-item">
      <svg class="perplexo-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
      <span>Free Express Shipping</span>
    </div>

    <div class="perplexo-pdp__trust-item">
      <svg class="perplexo-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span>14-Day Guarantee</span>
    </div>

    <div class="perplexo-pdp__trust-item">
      <svg class="perplexo-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path><path d="m9 12 2 2 4-4"></path>
      </svg>
      <span>100% Clean Formulas</span>
    </div>

    <div class="perplexo-pdp__trust-item">
      <svg class="perplexo-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
      <span>Dermatologist Approved</span>
    </div>
  </div>

  <!-- Product Accordion Tabs -->
  <div class="perplexo-pdp__accordions">
    
    <!-- Tab 1: Description & Ingredients -->
    <div class="perplexo-pdp__accordion-item is-open">
      <button type="button" class="perplexo-pdp__accordion-trigger">
        <span>Description & Key Benefits</span>
        <span class="perplexo-pdp__accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="perplexo-pdp__accordion-content">
        {%- if product.description != blank -%}
          <div class="rte">{{ product.description }}</div>
        {%- else -%}
          <p>Formulated with pure botanical extracts, hydrolyzed collagen, and deep hydrating hyaluronic acid. Replenishes moisture reserves, refines skin elasticity, and visibly fades blemishes without irritation. Free from parabens, sulfates, and synthetic dyes.</p>
        {%- endif -%}
      </div>
    </div>

    <!-- Tab 2: How to Apply -->
    <div class="perplexo-pdp__accordion-item">
      <button type="button" class="perplexo-pdp__accordion-trigger">
        <span>How to Apply (Daily Skincare Ritual)</span>
        <span class="perplexo-pdp__accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="perplexo-pdp__accordion-content">
        <p>Apply 2 to 3 drops onto freshly cleansed face and neck every morning and evening. Gently press into skin using upward circular motions until fully absorbed. Follow with your favorite Preplexo moisturizer for maximum hydration.</p>
      </div>
    </div>

    <!-- Tab 3: Shipping & Returns -->
    <div class="perplexo-pdp__accordion-item">
      <button type="button" class="perplexo-pdp__accordion-trigger">
        <span>Shipping & 14-Day Return Guarantee</span>
        <span class="perplexo-pdp__accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="perplexo-pdp__accordion-content">
        <p>Delivery takes 3–5 business days. You can request a return within 14 days. Contact <code>preplexo4@gmail.com</code> for a hassle-free refund.</p>
      </div>
    </div>

  </div>

</div>

<!-- Sticky PDP Buy Bar (Fixed Bottom on Scroll) -->
<div class="perplexo-pdp__sticky-bar" id="PerplexoStickyBar">
  <div class="perplexo-pdp__sticky-container">
    <div class="perplexo-pdp__sticky-info">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" class="perplexo-pdp__sticky-img" width="46" height="46" loading="lazy">
      {%- endif -%}
      <div class="perplexo-pdp__sticky-text">
        <span class="perplexo-pdp__sticky-title">{{ product.title | escape }}</span>
        <span class="perplexo-pdp__sticky-price">{{ price | money }}</span>
      </div>
    </div>
    <button
      type="button"
      class="perplexo-pdp__sticky-btn"
      onclick="var f = document.querySelector('#PerplexoPdpForm-{{ section.id }}') || document.querySelector('form[action*=\'/cart/add\']'); if (f) { f.submit(); } else { window.scrollTo({top: 0, behavior: 'smooth'}); }"
    >
      ⚡ Buy Now
    </button>
  </div>
</div>

<!-- PDP Accordion & Sticky Bar JS -->
<script>
  (function initPerplexoPdp() {
    var container = document.getElementById('PerplexoBuyBox-{{ section.id }}');
    if (!container) return;

    // Move "Choose your offer" into the buybox slot; drop any duplicates (non-DIY only)
    (function moveQuantityBreaksBeforeActions() {
      function run() {
        var buybox = document.getElementById('PerplexoBuyBox-{{ section.id }}');
        if (buybox && buybox.classList.contains('perplexo-pdp-buybox--diy')) return;

        var slot = document.getElementById('PerplexoQbSlot-{{ section.id }}');
        if (!slot) return;

        var info = document.getElementById('ProductInfo-{{ section.id }}') || document;
        var source = info.querySelector('[data-perplexo-qb-source="{{ section.id }}"]');
        var qbs = info.querySelectorAll('.quantity-breaks-container');
        if (!qbs.length) return;

        var primary = (source && source.querySelector('.quantity-breaks-container')) || qbs[0];
        if (!slot.contains(primary)) {
          slot.appendChild(primary);
        }

        info.querySelectorAll('.quantity-breaks-container').forEach(function (qb) {
          if (qb !== primary) qb.remove();
        });
        if (source) source.remove();

        var formId = 'PerplexoPdpForm-{{ section.id }}';
        primary.querySelectorAll('input[type="radio"][name="quantity"]').forEach(function (input) {
          input.setAttribute('form', formId);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
    })();

    // Accordions toggle
    var triggers = container.querySelectorAll('.perplexo-pdp__accordion-trigger');
    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        var item = trigger.closest('.perplexo-pdp__accordion-item');
        var isOpen = item.classList.contains('is-open');

        container.querySelectorAll('.perplexo-pdp__accordion-item').forEach(function(el) {
          el.classList.remove('is-open');
        });

        if (!isOpen) {
          item.classList.add('is-open');
        }
      });
    });

    // Sticky PDP bar — only when primary ATC scrolls out of view (avoids covering it)
    var stickyBar = document.getElementById('PerplexoStickyBar');

    if (stickyBar) {
      if (stickyBar.parentElement !== document.body) {
        document.body.appendChild(stickyBar);
      }

      var atcTarget =
        container.querySelector('[data-diy-add-to-cart]') ||
        container.querySelector('.perplexo-diy__btn--primary') ||
        container.querySelector('.perplexo-pdp__btn-add-cart') ||
        container.querySelector('.perplexo-pdp__btn-buy-now') ||
        container.querySelector('.perplexo-pdp__form');

      function setStickyVisible(visible) {
        stickyBar.classList.toggle('is-visible', !!visible);
      }

      if (atcTarget && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            var entry = entries[0];
            // Show sticky only once the main ATC is mostly off-screen
            setStickyVisible(!(entry && entry.isIntersecting && entry.intersectionRatio > 0.15));
          },
          { root: null, threshold: [0, 0.15, 0.5, 1], rootMargin: '0px 0px -8px 0px' }
        );
        observer.observe(atcTarget);
      } else {
        function checkStickyVisibility() {
          if (!atcTarget) {
            setStickyVisible(false);
            return;
          }
          var rect = atcTarget.getBoundingClientRect();
          var inView = rect.bottom > 80 && rect.top < window.innerHeight - 40;
          setStickyVisible(!inView);
        }
        window.addEventListener('scroll', checkStickyVisibility, { passive: true });
        window.addEventListener('resize', checkStickyVisibility, { passive: true });
        checkStickyVisibility();
      }
    }
  })();
</script>
