      "default": "Based on 480+ verified customer reviews"
    },
    {
      "type": "text",
      "id": "metric_1",
      "label": "Metric 1 Pill",
      "default": "98% Noticed Firmer Skin"
    },
    {
      "type": "text",
      "id": "metric_2",
      "label": "Metric 2 Pill",
      "default": "95% Saw Enhanced Radiance"
    },
    {
      "type": "text",
      "id": "metric_3",
      "label": "Metric 3 Pill",
      "default": "99% Would Recommend"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Marquee Loop Duration (Lower = Faster, Higher = Slower)",
      "default": 42
    },
    {
      "type": "color",
