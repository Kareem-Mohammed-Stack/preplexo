{{ 'perplexo-diy-videos.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_diy_product = false
  assign diy_title = product.title | downcase
  assign diy_handle = product.handle | downcase
  if diy_title contains 'diy' or diy_handle contains 'diy'
    assign is_diy_product = true
  endif
  for diy_tag in product.tags
    assign diy_tag_down = diy_tag | downcase
    if diy_tag_down == 'diy' or diy_tag_down contains 'diy'
      assign is_diy_product = true
      break
    endif
  endfor
-%}

{%- if is_diy_product or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <section
    class="perplexo-diy-videos section-{{ section.id }}-padding"
    id="DiyVideos-{{ section.id }}"
    data-section-id="{{ section.id }}"
    {% unless is_diy_product %}hidden{% endunless %}
  >
    <div class="perplexo-diy-videos__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="perplexo-diy-videos__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="perplexo-diy-videos__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="perplexo-diy-videos__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="perplexo-diy-videos__scroller" aria-label="DIY bracelet videos">
      <div class="perplexo-diy-videos__track">
        {%- assign diy_videos = 'vid-3.mp4,vid-4.mp4,bracelet-vid-1.mp4,bracelet-vid-2.mp4' | split: ',' -%}
        {%- for video_file in diy_videos -%}
          <div class="perplexo-diy-videos__slide">
            <div class="perplexo-diy-videos__card">
              <video
                class="perplexo-diy-videos__video"
                src="{{ video_file | strip | asset_url }}"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label="DIY bracelet video {{ forloop.index }}"
              ></video>
              <button type="button" class="perplexo-diy-videos__mute" aria-label="Toggle mute">
                <svg class="icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
                <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                </svg>
              </button>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var section = document.getElementById('DiyVideos-{{ section.id }}');
      if (!section) return;

      section.querySelectorAll('.perplexo-diy-videos__card').forEach(function (card) {
        var video = card.querySelector('video');
        var muteBtn = card.querySelector('.perplexo-diy-videos__mute');
        if (!video || !muteBtn) return;

        function toggleMute(e) {
          if (e) e.stopPropagation();
          video.muted = !video.muted;
          muteBtn.classList.toggle('is-unmuted', !video.muted);
          muteBtn.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
        }

        muteBtn.addEventListener('click', toggleMute);
        video.addEventListener('click', toggleMute);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Perplexo DIY Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows on DIY product pages only. Place after testimonials. Uses theme assets: vid-3, vid-4, bracelet-vid-1, bracelet-vid-2. Desktop: one row. Mobile: horizontal carousel."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SEE IT IN ACTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make your bracelet"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch the charms, the guide, and finished looks."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Perplexo DIY Videos"
    }
  ]
}
{% endschema %}
