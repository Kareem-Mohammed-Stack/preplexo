{% doc %}
  Renders Bundle & Save cards. Include after aura-bundle-products.
  @param {string} [ns] - CSS suffix, usually -pdp
  @param {string} [radio_name] - Radio group name
  @param {string} [id_prefix] - Input id prefix
{% enddoc %}
{%- liquid
  assign ns = ns | default: ''
  assign radio_name = radio_name | default: 'aura_bundle_product_select_pdp'
  assign id_prefix = id_prefix | default: 'pdp-bundle-card'
-%}

{%- if bundle_count > 0 -%}
  {%- for i in (1..8) -%}
    {%- liquid
      assign pack = nil
      assign pack_qty = 0
      case i
        when 1
          assign pack = bundle_1
          assign pack_qty = bundle_1_qty
        when 2
          assign pack = bundle_2
          assign pack_qty = bundle_2_qty
        when 3
          assign pack = bundle_3
          assign pack_qty = bundle_3_qty
        when 4
          assign pack = bundle_4
          assign pack_qty = bundle_4_qty
        when 5
          assign pack = bundle_5
          assign pack_qty = bundle_5_qty
        when 6
          assign pack = bundle_6
          assign pack_qty = bundle_6_qty
        when 7
          assign pack = bundle_7
          assign pack_qty = bundle_7_qty
        when 8
          assign pack = bundle_8
          assign pack_qty = bundle_8_qty
      endcase
    -%}
    {%- if pack != blank and pack.id != blank -%}
      {%- liquid
        assign pack_var = pack.selected_or_first_available_variant
        assign pack_price = pack_var.price
        assign pack_compare = 0
        if pack_var.compare_at_price != blank and pack_var.compare_at_price > pack_price
          assign pack_compare = pack_var.compare_at_price
        endif
        assign is_default = false
        if pack_qty == default_bundle_qty
          assign is_default = true
        endif
        assign is_last = false
        if i == bundle_count and bundle_count > 2
          assign is_last = true
        endif
        assign is_first = false
        if i == 1
          assign is_first = true
        endif
      -%}
      <div class="aura-bundle-card-wrapper{{ ns }}">
        {%- if is_default -%}
          <span class="aura-bundle-corner-ribbon{{ ns }}">Most Popular</span>
        {%- elsif is_last -%}
          <span class="aura-bundle-corner-ribbon{{ ns }}">Best Value</span>
        {%- endif -%}
        <input
          type="radio"
          id="{{ id_prefix }}-{{ pack_qty }}-{{ section.id }}"
          name="{{ radio_name }}"
          value="{{ pack_var.id }}"
          data-qty="{{ pack_qty }}"
          data-variant-id="{{ pack_var.id }}"
          data-mode="product"
          class="aura-bundle-radio-input{{ ns }}"
          {% if is_default %}checked{% endif %}
        >
        <label for="{{ id_prefix }}-{{ pack_qty }}-{{ section.id }}" class="aura-bundle-card-label{{ ns }}">
          <div class="aura-bundle-card-left{{ ns }}">
            <span class="aura-bundle-radio-circle{{ ns }}"><span class="aura-bundle-radio-dot{{ ns }}"></span></span>
            <div class="aura-bundle-info{{ ns }}">
              <div class="aura-bundle-title-row{{ ns }}">
                <span class="aura-bundle-title{{ ns }}">{{ pack.title }}</span>
                {%- if is_first and pack_compare > pack_price and is_default == false -%}
                  <span class="aura-bundle-inline-badge{{ ns }}">Discounted Price</span>
                {%- endif -%}
              </div>
              <span class="aura-bundle-subtext{{ ns }}">Free Shipping</span>
            </div>
          </div>
          <div class="aura-bundle-card-right{{ ns }}">
            <span class="aura-bundle-price{{ ns }}">{% render 'aura-money', amount: pack_price %}</span>
            {%- if pack_compare > pack_price -%}
              <span class="aura-bundle-compare-price{{ ns }}">{% render 'aura-money', amount: pack_compare %}</span>
            {%- endif -%}
          </div>
        </label>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- liquid
    assign fallback_variant = product.selected_or_first_available_variant
    assign fallback_unit = fallback_variant.price
    assign fallback_compare_unit = fallback_variant.compare_at_price | default: fallback_unit
    if fallback_compare_unit <= fallback_unit
      assign fallback_compare_unit = fallback_unit
    endif
  -%}
  {%- for qty in (1..3) -%}
    {%- liquid
      case qty
        when 1
          assign pack_price = fallback_unit
          assign pack_compare = fallback_compare_unit
          assign pack_title = 'Buy 1'
          assign is_default = false
          assign show_discount_badge = true
        when 2
          assign pack_price = 5499
          assign pack_compare = fallback_compare_unit | times: 2
          assign pack_title = 'Buy 2'
          assign is_default = true
          assign show_discount_badge = false
        else
          assign pack_price = 6499
          assign pack_compare = fallback_compare_unit | times: 3
          assign pack_title = 'Buy 3'
          assign is_default = false
          assign show_discount_badge = false
      endcase
    -%}
    <div class="aura-bundle-card-wrapper{{ ns }}">
      {%- if is_default -%}
        <span class="aura-bundle-corner-ribbon{{ ns }}">Most Popular</span>
      {%- elsif qty == 3 -%}
        <span class="aura-bundle-corner-ribbon{{ ns }}">Best Value</span>
      {%- endif -%}
      <input
        type="radio"
        id="{{ id_prefix }}-{{ qty }}-{{ section.id }}"
        name="{{ radio_name }}"
        value="{{ fallback_variant.id }}"
        data-qty="{{ qty }}"
        data-variant-id="{{ fallback_variant.id }}"
        data-mode="qty"
        class="aura-bundle-radio-input{{ ns }}"
        {% if is_default %}checked{% endif %}
      >
      <label for="{{ id_prefix }}-{{ qty }}-{{ section.id }}" class="aura-bundle-card-label{{ ns }}">
        <div class="aura-bundle-card-left{{ ns }}">
          <span class="aura-bundle-radio-circle{{ ns }}"><span class="aura-bundle-radio-dot{{ ns }}"></span></span>
          <div class="aura-bundle-info{{ ns }}">
            <div class="aura-bundle-title-row{{ ns }}">
              <span class="aura-bundle-title{{ ns }}">{{ pack_title }}</span>
              {%- if show_discount_badge -%}
                <span class="aura-bundle-inline-badge{{ ns }}">Discounted Price</span>
              {%- endif -%}
            </div>
            <span class="aura-bundle-subtext{{ ns }}">Free Shipping</span>
          </div>
        </div>
        <div class="aura-bundle-card-right{{ ns }}">
          <span class="aura-bundle-price{{ ns }}">{% render 'aura-money', amount: pack_price %}</span>
          {%- if pack_compare > pack_price -%}
            <span class="aura-bundle-compare-price{{ ns }}">{% render 'aura-money', amount: pack_compare %}</span>
          {%- endif -%}
        </div>
      </label>
    </div>
  {%- endfor -%}
{%- endif -%}
