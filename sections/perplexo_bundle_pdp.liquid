{{ 'perplexo-bundle-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign target_id = 10395357118760
  assign bundle_prod = section.settings.bundle_product

  if bundle_prod == blank
    for p in collections['all'].products
      if p.id == target_id or p.selected_or_first_available_variant.id == target_id
        assign bundle_prod = p
        break
      endif
      for v in p.variants
        if v.id == target_id
          assign bundle_prod = p
          break
        endif
      endfor
    endfor
  endif

  if bundle_prod == blank
    assign bundle_prod = collections['all'].products.first
  endif
  
  if bundle_prod != blank
    assign bundle_title = bundle_prod.title
    assign bundle_subtitle = bundle_prod.description | strip_html | default: section.settings.subtitle | truncate: 200
    assign bundle_price = bundle_prod.price | money
    if bundle_prod.compare_at_price > bundle_prod.price
      assign bundle_compare = bundle_prod.compare_at_price | money
    else
      assign bundle_compare = section.settings.compare_price | default: '75$'
    endif
    assign bundle_media = bundle_prod.featured_media
    assign bundle_variant = bundle_prod.selected_or_first_available_variant
  else
    assign bundle_title = section.settings.title | default: 'The Collagen Essentials Duo'
    assign bundle_subtitle = section.settings.subtitle | default: 'Everyday hydration & pore tightening essential set'
    assign bundle_price = section.settings.price | default: '60$'
    assign bundle_compare = section.settings.compare_price | default: '75$'
  endif
-%}

<section class="perplexo-bundle-pdp">
  <div class="page-width">
    <div class="perplexo-bundle-pdp__container">
      
      <!-- Left Column: Bundle Media & Included Items Showcase -->
      <div class="perplexo-bundle-pdp__gallery">
        <div class="perplexo-bundle-pdp__main-image-box">
          <span class="perplexo-bundle-pdp__save-badge-lg">{{ section.settings.savings_badge | default: 'SAVE 15%' }}</span>
          {%- if bundle_media != blank -%}
            {{ bundle_media | image_url: width: 1200 | image_tag: class: 'perplexo-bundle-pdp__main-img', loading: 'eager', alt: bundle_title }}
          {%- elsif section.settings.bundle_image != blank -%}
            {{ section.settings.bundle_image | image_url: width: 1200 | image_tag: class: 'perplexo-bundle-pdp__main-img', loading: 'eager', alt: bundle_title }}
          {%- else -%}
            <img src="{{ 'prod_melaxin_2.png' | asset_url }}" class="perplexo-bundle-pdp__main-img" loading="eager" alt="{{ bundle_title | escape }}" width="1200" height="1200">
          {%- endif -%}
        </div>

        <!-- Included Items Step-by-Step Breakdown -->
        <div class="perplexo-bundle-pdp__items-section">
          <h3 class="perplexo-bundle-pdp__items-heading">✨ What's Inside This Curated Bundle</h3>
          <div class="perplexo-bundle-pdp__items-grid">
            
            <div class="perplexo-bundle-pdp__item-card">
              <span class="perplexo-bundle-pdp__item-step">Item 1</span>
              <div class="perplexo-bundle-pdp__item-img-box">
                <img src="{{ 'prod_melaxin_2.png' | asset_url }}" class="perplexo-bundle-pdp__item-img" alt="Collagen Serum" width="64" height="64">
              </div>
              <div class="perplexo-bundle-pdp__item-details">
                <h4 class="perplexo-bundle-pdp__item-name">Dr. Melaxin Collagen Boost Serum (50ml)</h4>
                <p class="perplexo-bundle-pdp__item-benefit">Deep pore tightening & elasticity boost</p>
              </div>
              <span class="perplexo-bundle-pdp__item-val">$40 Value</span>
            </div>

            <div class="perplexo-bundle-pdp__item-card">
              <span class="perplexo-bundle-pdp__item-step">Item 2</span>
              <div class="perplexo-bundle-pdp__item-img-box">
                <img src="{{ 'prod_melaxin_1.png' | asset_url }}" class="perplexo-bundle-pdp__item-img" alt="Rose Hydrating Cream" width="64" height="64">
              </div>
              <div class="perplexo-bundle-pdp__item-details">
                <h4 class="perplexo-bundle-pdp__item-name">Organic Damask Rose Hydrating Cream (50ml)</h4>
                <p class="perplexo-bundle-pdp__item-benefit">24-hour hydration & radiant skin barrier lock</p>
              </div>
              <span class="perplexo-bundle-pdp__item-val">$35 Value</span>
            </div>

          </div>
        </div>
      </div>

      <!-- Right Column: High-Converting Bundle Buy Box -->
      <div class="perplexo-bundle-pdp__buybox">
        <div class="perplexo-bundle-pdp__rating-row">
          <span class="perplexo-bundle-pdp__stars">★★★★★</span>
          <span class="perplexo-bundle-pdp__rating-text">4.9/5 (1,150+ Verified Bundle Reviews)</span>
        </div>

        <h1 class="perplexo-bundle-pdp__title">{{ bundle_title | escape }}</h1>
        <p class="perplexo-bundle-pdp__subtitle">{{ bundle_subtitle | escape }}</p>

        <!-- Pricing Display -->
        <div class="perplexo-bundle-pdp__price-container">
          <span class="perplexo-bundle-pdp__sale-price">{{ bundle_price }}</span>
          {%- if bundle_compare != blank -%}
            <span class="perplexo-bundle-pdp__compare-price">{{ bundle_compare }}</span>
          {%- endif -%}
          <span class="perplexo-bundle-pdp__save-tag">🎉 You Save 15$ Instant Discount</span>
        </div>

        <!-- Stock Urgency Pill -->
        <div class="perplexo-bundle-pdp__urgency-pill">
          ⚡ In High Demand: Limited Kits Remaining · Delivery in 3–5 business days
        </div>

        <!-- Primary Action Form -->
        {%- assign target_variant_id = bundle_variant.id | default: '10395357118760' -%}
        <product-form class="product-form" data-section-id="{{ section.id }}">
          <form method="post" action="{{ routes.cart_add_url }}" class="perplexo-bundle-pdp__form" id="product-form-{{ section.id }}" data-type="add-to-cart-form">
            <input type="hidden" name="id" value="{{ target_variant_id }}">
            <div class="product-form__buttons">
              <button type="submit" name="add" class="perplexo-bundle-pdp__buy-now-btn product-form__submit">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  <path d="M13 2L3 14h7v8l10-12h-7z"/>
                </svg>
                <span>BUY NOW — {{ bundle_price }}</span>
                <div class="loading__spinner hidden">
                  <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </button>
            </div>
          </form>
        </product-form>

        <!-- Trust Badges Grid (Online Encrypted Payment Only) -->
        <div class="perplexo-bundle-pdp__trust-grid">
          <div class="perplexo-bundle-pdp__trust-item">
            <svg class="perplexo-bundle-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Free Express Shipping</span>
          </div>

          <div class="perplexo-bundle-pdp__trust-item">
            <svg class="perplexo-bundle-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>100% Encrypted Online Payment</span>
          </div>

          <div class="perplexo-bundle-pdp__trust-item">
            <svg class="perplexo-bundle-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>14-Day Money Back Guarantee</span>
          </div>

          <div class="perplexo-bundle-pdp__trust-item">
            <svg class="perplexo-bundle-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>Dermatologist Approved</span>
          </div>
        </div>

        <!-- Accordions -->
        <div class="perplexo-bundle-pdp__accordions">
          <details class="perplexo-bundle-pdp__accordion" open>
            <summary class="perplexo-bundle-pdp__accordion-summary">
              <span>🌿 How to Apply Daily Ritual</span>
              <span>+</span>
            </summary>
            <div class="perplexo-bundle-pdp__accordion-content">
              <strong>Morning & Evening Protocol:</strong><br>
              1. Dispense 1 pump of Cleansing Foam onto wet skin and gently massage in circular motions.<br>
              2. Apply 3-4 drops of Hyaluron Serum to damp face and neck, patting gently.<br>
              3. Seal with a pea-sized amount of Moisture Cream for 24-hour hydration lock.
            </div>
          </details>

          <details class="perplexo-bundle-pdp__accordion">
            <summary class="perplexo-bundle-pdp__accordion-summary">
              <span>📦 Shipping & 14-Day Guarantee</span>
              <span>+</span>
            </summary>
            <div class="perplexo-bundle-pdp__accordion-content">
              Delivery takes 3–5 business days. You can request a return within 14 days.
            </div>
          </details>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Sticky Mobile Add To Cart Bar -->
<div class="perplexo-bundle-sticky-bar" id="perplexo-sticky-bar">
  <div class="perplexo-bundle-sticky-bar__inner">
    <div class="perplexo-bundle-sticky-bar__info">
      <span class="perplexo-bundle-sticky-bar__title">{{ bundle_title | escape | truncate: 30 }}</span>
      <span class="perplexo-bundle-sticky-bar__price">{{ bundle_price }}</span>
    </div>
    <product-form class="product-form" data-section-id="{{ section.id }}">
      <form method="post" action="{{ routes.cart_add_url }}" id="product-form-sticky-{{ section.id }}" data-type="add-to-cart-form">
        <input type="hidden" name="id" value="{{ target_variant_id }}">
        <button type="submit" name="add" class="perplexo-bundle-sticky-bar__btn product-form__submit">
          ADD TO CART
          <div class="loading__spinner hidden">
            <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
            </svg>
          </div>
        </button>
      </form>
    </product-form>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const mainButton = document.querySelector('.perplexo-bundle-pdp__form .perplexo-bundle-pdp__buy-now-btn');
    const stickyBar = document.getElementById('perplexo-sticky-bar');
    
    if (mainButton && stickyBar) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          // Show sticky bar when main button is scrolled past (above viewport)
          if (!entry.isIntersecting && entry.boundingClientRect.y < 0) {
            stickyBar.classList.add('is-visible');
          } else {
            stickyBar.classList.remove('is-visible');
          }
        });
      }, { threshold: 0 });
      
      observer.observe(mainButton);
    }
  });
</script>

{% schema %}
{
  "name": "Perplexo Bundle Details",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Bundle Title",
      "default": "Starter Glowing Skin Transformation Duo"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Bundle Subtitle",
      "default": "Complete 3-step clinical routine for instant pore refinement, intense hydration & healthy glass skin glow."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Bundle Price",
      "default": "$55.00"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Original Price",
      "default": "$85.00"
    },
    {
      "type": "text",
      "id": "savings_badge",
      "label": "Savings Badge Text",
      "default": "SAVE 35% OFF"
    },
    {
      "type": "image_picker",
      "id": "bundle_image",
      "label": "Bundle Featured Image"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Shopify Bundle Product (For Direct Checkout)"
    }
  ]
}
{% endschema %}
