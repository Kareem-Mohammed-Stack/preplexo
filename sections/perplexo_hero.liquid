{{ 'perplexo-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="perplexo-hero section-{{ section.id }}-padding">
  <div class="page-width perplexo-hero__inner">
    <div class="perplexo-hero__content">
      {%- if section.settings.brand_title != blank -%}
        <span class="perplexo-hero__brand">{{ section.settings.brand_title | escape }}</span>
      {%- endif -%}

      {%- if section.settings.sub_tagline != blank -%}
        <span class="perplexo-hero__sub-tagline">{{ section.settings.sub_tagline | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" style="color: inherit; text-decoration: none;">
          <h1 class="perplexo-hero__heading h1">{{ section.settings.heading | escape }}</h1>
        </a>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="perplexo-hero__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="perplexo-hero__action">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="perplexo-hero__btn button button--primary">
            <span>{{ section.settings.button_label | escape }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="perplexo-hero__grid-container">
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="perplexo-hero__card perplexo-hero__card--1">
        {%- if section.settings.image_1 != blank -%}
          {{ section.settings.image_1 | image_url: width: 800 | image_tag: class: 'perplexo-hero__img', loading: 'eager', alt: 'Perplexo Skincare Product 1' }}
        {%- else -%}
          <img src="{{ 'hero_card1.png' | asset_url }}" class="perplexo-hero__img" loading="eager" alt="Preplexo Skincare Product 1" width="800" height="800">
        {%- endif -%}
      </a>

      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="perplexo-hero__card perplexo-hero__card--2">
        {%- if section.settings.image_2 != blank -%}
          {{ section.settings.image_2 | image_url: width: 800 | image_tag: class: 'perplexo-hero__img', loading: 'eager', alt: 'Perplexo Skincare Product 2' }}
        {%- else -%}
          <img src="{{ 'hero_card2.png' | asset_url }}" class="perplexo-hero__img" loading="eager" alt="Preplexo Skincare Product 2" width="800" height="800">
        {%- endif -%}
      </a>

      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="perplexo-hero__card perplexo-hero__card--3">
        {%- if section.settings.image_3 != blank -%}
          {{ section.settings.image_3 | image_url: width: 800 | image_tag: class: 'perplexo-hero__img', loading: 'eager', alt: 'Perplexo Skincare Product 3' }}
        {%- else -%}
          <img src="{{ 'hero_card3.png' | asset_url }}" class="perplexo-hero__img" loading="eager" alt="Preplexo Skincare Product 3" width="800" height="800">
        {%- endif -%}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perplexo Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "Preplexo"
    },
    {
      "type": "text",
      "id": "sub_tagline",
      "label": "Sub-tagline",
      "default": "Signature Skin care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Every Skin Care Here"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Crafted for the woman who defines her own legacy. Timeless silhouettes, refined finishes, and effortless elegance—made to be lived in."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop The Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Image Showcase Cards"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Top Card Image (Card 1)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Bottom Left Card Image (Card 2)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Right Overlapping Card Image (Card 3)"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Perplexo Hero"
    }
  ]
}
{% endschema %}
